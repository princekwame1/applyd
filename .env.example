APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — cPanel SMTP.
# In cPanel: Email Accounts → the account → "Connect Devices" → Mail Client
# Manual Settings. Use the SSL/TLS values shown there.
#   MAIL_HOST      = mail.yourdomain.com  (the "Outgoing Server" cPanel lists)
#   MAIL_PORT/SCHEME = 465 + smtps  (SSL, recommended)  or  587 + smtp (STARTTLS)
#   MAIL_USERNAME  = the FULL email address, not just the mailbox name
#   MAIL_FROM_ADDRESS must be a real mailbox on that domain or the host will
#   reject the message / it will land in spam.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sending limit -----------------------------------------------------------
# cPanel caps how many messages the account may relay per rolling hour; go over
# and the host rejects everything until the window moves. Mail is therefore
# queued and released at this rate rather than sent inline.
#
# Set it a little BELOW the allowance your host shows (WHM/cPanel "Max Hourly
# Emails", or your host's support docs). Under-setting only makes a big send
# take longer; over-setting bounces mail. 0 turns the throttle off.
MAIL_HOURLY_LIMIT=100
# How long a message may keep being retried before it is written off as failed.
MAIL_RETRY_HOURS=24
# Queue names. Transactional mail rides the first, a bulk broadcast the second,
# so a 500-recipient blast can never sit in front of a student's login email.
MAIL_QUEUE=emails
MAIL_QUEUE_BULK=emails-bulk

# --- The worker --------------------------------------------------------------
# Queued mail only leaves if something drains the queue. QUEUE_CONNECTION must
# NOT be "sync" (sync sends inline and ignores the throttle entirely).
#
# The scheduler already runs a short worker every five minutes, so on shared
# cPanel hosting the single cron line below is all that is needed:
#
#   * * * * * cd /home/USER/APP && php artisan schedule:run >> /dev/null 2>&1
#
# If the host allows a long-running process, a dedicated worker is better —
# mail then goes out within seconds instead of within five minutes:
#
#   php artisan queue:work --queue=emails,emails-bulk,default --sleep=3 --tries=3
#
# After changing any of the above on the server: php artisan config:clear

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack (course registration form fee)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS

# Pass Paystack's transaction charge on to the payer. The bill is grossed up so
# the advertised price is what actually lands in the account. Confirm the rates
# against your own Paystack dashboard — they vary by country and method.
# Leave PAYSTACK_FEE_CAP blank for no cap.
PAYSTACK_PASS_ON_FEE=false
PAYSTACK_FEE_PERCENT=1.95
PAYSTACK_FEE_FIXED=0
PAYSTACK_FEE_CAP=

# Learning portal (applyd-portal) — its own app on this same database, sharing
# these accounts. Students sign in there, so issued credentials link to it.
# No trailing slash. Live value: https://sts.applydacademy.com
PORTAL_URL=https://sts.yourdomain.com
