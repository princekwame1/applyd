APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — Mailgun (HTTP API, not SMTP).
# In Mailgun: Send → Domains for MAILGUN_DOMAIN (the sending domain whose DNS
# you verified — SPF, DKIM and the tracking CNAME all green), then API keys for
# MAILGUN_SECRET.
#   MAILGUN_SECRET   = the key's SECRET, shown once when the key is created.
#                      The dashboard lists only the key id afterwards, so if it
#                      was not saved, create a new key — it cannot be read back.
#   MAILGUN_ENDPOINT = api.mailgun.net (US, default) or api.eu.mailgun.net (EU).
#                      A key issued in one region will not authenticate in the
#                      other; the 401 that follows says nothing about regions.
#   MAIL_FROM_ADDRESS must be on MAILGUN_DOMAIN — Mailgun refuses to send as a
#                      domain it has not verified.
MAIL_MAILER=mailgun
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Queue or send inline ----------------------------------------------------
# false (the default): an email goes to Mailgun during the request that caused
# it, and its Email Delivery row reads sent/failed by the time the page loads.
# The queue existed to pace the old cPanel relay's hourly cap; Mailgun has no
# cap worth pacing at this volume, so queueing bought a worker and a delay for
# nothing.
#
# Turn it on (with QUEUE_CONNECTION not "sync") if a broadcast ever grows big
# enough that sending it inside one HTTP request would hit the server's
# max_execution_time — a few hundred recipients is where that starts to bite.
# Everything below this line only applies while it is on.
MAIL_QUEUE_ENABLED=false

# --- Sending limit (only while MAIL_QUEUE_ENABLED=true) ----------------------
# Mailgun rate-limits by plan and answers anything past it with 429, so mail is
# queued and released at this rate rather than sent inline. A trial account is
# capped hard, and a freshly verified domain should be warmed up rather than
# opened with a 500-recipient blast.
#
# Set it a little BELOW your plan's limit. Under-setting only makes a big send
# take longer; over-setting gets mail throttled, then bounced. 0 turns the
# throttle off.
MAIL_HOURLY_LIMIT=100
# How long a message may keep being retried before it is written off as failed.
MAIL_RETRY_HOURS=24
# Queue names. Transactional mail rides the first, a bulk broadcast the second,
# so a 500-recipient blast can never sit in front of a student's login email.
MAIL_QUEUE=emails
MAIL_QUEUE_BULK=emails-bulk

# --- The worker (only while MAIL_QUEUE_ENABLED=true) --------------------------
# Queued mail only leaves if something drains the queue. QUEUE_CONNECTION must
# NOT be "sync" (sync sends inline and ignores the throttle entirely). With
# MAIL_QUEUE_ENABLED=false none of this runs — the schedule entry isn't even
# registered, so there is no worker waking every five minutes to find nothing.
#
# The scheduler already runs a short worker every five minutes, so on shared
# cPanel hosting the single cron line below is all that is needed:
#
#   * * * * * cd /home/USER/APP && php artisan schedule:run >> /dev/null 2>&1
#
# If the host allows a long-running process, a dedicated worker is better —
# mail then goes out within seconds instead of within five minutes:
#
#   php artisan queue:work --queue=emails,emails-bulk,default --sleep=3 --tries=3
#
# After changing any of the above on the server: php artisan config:clear

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack (course registration form fee)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS

# Pass Paystack's transaction charge on to the payer. The bill is grossed up so
# the advertised price is what actually lands in the account. Confirm the rates
# against your own Paystack dashboard — they vary by country and method.
# Leave PAYSTACK_FEE_CAP blank for no cap.
PAYSTACK_PASS_ON_FEE=false
PAYSTACK_FEE_PERCENT=1.95
PAYSTACK_FEE_FIXED=0
PAYSTACK_FEE_CAP=

# Learning portal (applyd-portal) — its own app on this same database, sharing
# these accounts. Students sign in there, so issued credentials link to it.
# No trailing slash. Live value: https://sts.applydacademy.com
PORTAL_URL=https://sts.yourdomain.com
