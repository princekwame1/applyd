  "item": [
    {
      "name": "Quick Send SMS",
      "item": [
        {
          "name": "Send Single SMS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{mnotify_api_key}}\",\n  \"recipient\": [\n    \"+233542313610\"\n  ],\n  \"message\": \"Hi Ama! Welcome to Applyd Academy. You're all set for the Digital Tools Bootcamp. Check your email for session details. Let's grow together.\",\n  \"sender\": \"{{mnotify_sender}}\"\n}"
            },
            "url": {
              "raw": "https://api.mnotify.com/api/sms/quick",
              "protocol": "https",
              "host": [
                "api",
                "mnotify",
                "com"
              ],
              "path": [
                "api",
                "sms",
                "quick"
              ]
            },
            "description": "Send SMS to a single recipient"
          }
        },
